# Secrets. This repo goes public at submission.
.env
.env.*
!.env.example
*.key
*.pem
id_rsa
id_ed25519

# Generated
findings*.json
# ...but the Phase B spike findings ARE the evidence base, and a finding that
# only exists in a terminal scrollback is not evidence. These five carry no
# credential and no balance -- spike 8 records that the balance was READABLE
# and deliberately withholds the figure -- so they are committed on purpose.
# `findings.json` (spike 1) stays ignored: it records the account balance.
!spike/findings-spike5.json
!spike/findings-spike6.json
!spike/findings-spike7.json
!spike/findings-spike8.json
!spike/findings-spike9.json
__pycache__/
*.pyc
.venv/

# Runtime state. LEADING SLASH: a bare `data/` matches a directory of that
# name at ANY depth, which silently swallowed docs/data/ -- a committed source
# artifact, not runtime state. Anchor it to the repo root.
/data/

# Local build contexts assembled by `just image`.
/.build/

# Coverage output. `just test` writes it on every run.
.coverage
coverage.xml
htmlcov/

# Web application (apps/web). node_modules and the Next build are derived;
# the generated API client is derived too, from packages/contracts/openapi.json
# -- which is why that file is checked in and the client is not.
node_modules/
.next/
out/
*.tsbuildinfo
/apps/web/src/lib/api/generated/
test-results/
playwright-report/
