# Build context for the stack images (compose.yaml, issue #29). The context is
# the repository root because both Dockerfiles need files outside their own
# directory: the control plane resolves the uv workspace (root pyproject.toml +
# uv.lock + every member manifest), and the web client generates from
# packages/contracts/openapi.json.
#
# Everything heavy or derived is excluded; source and lockfiles stay.

# VCS and environments
.git
.venv
data

# Scratch files working agents keep in-tree (never ships)
.scratch

# Secrets. spike/.env carries a live key and must never enter an image.
.env
.env.*
spike/.env
*.key
*.pem

# Python caches
**/__pycache__
*.pyc

# Web: node_modules and the Next build are derived, the generated API client
# is derived too (regenerated by the image's own build).
node_modules
apps/web/node_modules
apps/web/.next
apps/web/test-results
apps/web/playwright-report
apps/web/src/lib/api/generated
apps/web/next-env.d.ts
*.tsbuildinfo
