    "/v1/datasets": {
      "get": {
        "operationId": "list_datasets_v1_datasets_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatasetList"
                }
              }
            },
            "description": "Successful Response"
          }
        },
