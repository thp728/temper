          "datasets"
        ]
      },
      "post": {
        "description": "Upload and validate a JSONL dataset.\n\n**Deliberately a sync handler.** It was `async def`, which ran the\nCPU-bound validation on the event loop and froze every other request for\nas long as it ran -- measured at roughly 80 ms per megabyte, so a 200 MB\nupload blocked the whole server for ~16 seconds. Declared `def` instead,\nFastAPI dispatches it to its worker pool and a long validation blocks only\nits own request. Regression-tested by\n`test_upload_limits.test_large_upload_does_not_block_concurrent_requests`.\n\nStorage and validation live in `datasets.store_and_validate`, shared with\nthe browser's upload form, so the two surfaces cannot drift apart.\n\nDatasets over `config.MAX_DATASET_BYTES` are refused before validation --\nan unbounded upload fails as an out-of-memory crash rather than a typed\nerror, which is worse for the user and for the process.",
        "operationId": "upload_dataset_v1_datasets_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_dataset_v1_datasets_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatasetUploaded"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Upload Dataset",
        "tags": [
          "datasets"
        ]
      }
    },
