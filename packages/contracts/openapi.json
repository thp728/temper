    "/v1/jobs/{job_id}/cancel": {
      "post": {
        "description": "Ask a running job to stop. Destructive, and says so.\n\nThe request records the user's decision; the thread running the job sees it\nwithin a poll interval, destroys the machine and ends the job `cancelled`.\nSo this returns the state the job is in *now*, which is usually still a\nworking one \u2014 reporting `cancelled` here would claim a teardown that has\nnot happened yet, and teardown is the whole point of cancelling.\n\nRepeating it succeeds quietly: a double-clicked button is not an error.\nCancelling a job that has already ended is refused with a stable code,\nbecause nothing was undone and the user should not think otherwise.",
        "operationId": "cancel_job_v1_jobs__job_id__cancel_post",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Cancel Job",
        "tags": [
          "jobs"
        ]
      }
    },
